{
  "format": 1,
  "kind": "petramond:inventory",
  "class": "container",
  "compact_below_w": 438,
  "root": {
    "type": "frame",
    "layout": {
      "dir": "row",
      "gap": 2,
      "align": "stretch",
      "anchor": { "h": "center", "v": "center" }
    },
    "compact_layout": {
      "dir": "column",
      "gap": 2,
      "align": "stretch",
      "anchor": { "h": "center", "v": "center" }
    },
    "children": [
      {
        "type": "column",
        "style": "panel.large",
        "layout": {
          "w": 220,
          "pad": [4, 3, 4, 4],
          "gap": 3,
          "align": "stretch"
        },
        "compact_layout": {
          "w": 220,
          "h": {
            "grow": 1
          },
          "min_h": 113,
          "pad": [4, 0, 4, 0],
          "gap": 3,
          "align": "stretch"
        },
        "children": [
          { "type": "label", "text": "Crafting" },
          {
            "type": "row",
            "layout": { "gap": 2, "align": "stretch" },
            "children": [
              {
                "type": "text_input",
                "id": "craft_search",
                "placeholder": "Search recipes...",
                "max_chars": 64,
                "layout": { "w": { "grow": 1 } },
                "bind": { "text": "craft_search" }
              },
              {
                "type": "toggle",
                "id": "craft_filter",
                "style": "button.toggle",
                "icon": "icon.craft_filter",
                "layout": { "w": 18, "h": 18 },
                "bind": { "value": "craft_filter_on" }
              }
            ]
          },
          {
            "type": "scroll",
            "id": "craft_scroll",
            "axis": "vertical",
            "style": "panel.inset",
            "layout": {
              "h": 100,
              "min_h": 48,
              "pad": [1, 1, 1, 1]
            },
            "compact_layout": {
              "h": {
                "grow": 1
              },
              "min_h": 28,
              "pad": [1, 1, 1, 1]
            },
            "children": [
              {
                "type": "label",
                "text": "No matching recipes",
                "wrap": true,
                "style": "label.muted",
                "bind": { "visible": "no_craft_results", "text": "craft_empty_hint" }
              },
              {
                "type": "list",
                "id": "craft_recipes_list",
                "cols": 9,
                "layout": {
                  "align": "stretch",
                  "gap": 1
                },
                "bind": {
                  "items": "craft_recipes",
                  "selected": "craft_recipe_sel"
                },
                "children": [
                  {
                    "type": "button",
                    "id": "recipe",
                    "style": "slot.recipe",
                    "layout": {
                      "h": 18,
                      "dir": "row",
                      "align": "center",
                      "justify": "center"
                    },
                    "bind": { "enabled": "enabled" },
                    "children": [
                      {
                        "type": "hook",
                        "id": "recipe_result",
                        "layout": { "w": 16, "h": 16 }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "layout": { "gap": 3, "align": "center" },
            "children": [
              {
                "type": "slot",
                "role": "craft_result"
              },
              {
                "type": "button",
                "id": "craft",
                "text": "CRAFT",
                "style": "button.success",
                "layout": { "w": { "grow": 1 } },
                "bind": { "enabled": "can_craft" }
              }
            ]
          }
        ]
      },
      {
        "type": "column",
        "style": "panel.large",
        "layout": {
          "pad": [4, 4, 4, 4],
          "align": "stretch"
        },
        "compact_layout": {
          "pad": [4, 3, 4, 4],
          "align": "center"
        },
        "children": [
          {
            "type": "column",
            "layout": {
              "h": { "grow": 1 },
              "gap": 6,
              "justify": "space_between",
              "align": "stretch"
            },
            "compact_layout": { "gap": 2, "align": "stretch" },
            "children": [
              {
                "type": "row",
                "layout": { "gap": 4, "align": "stretch" },
                "compact_layout": { "align": "stretch" },
                "children": [
                  {
                    "type": "frame",
                    "layout": {
                      "w": { "grow": 1 },
                      "dir": "column",
                      "justify": "end"
                    },
                    "compact_layout": {
                      "w": { "grow": 1 },
                      "dir": "row",
                      "justify": "start"
                    },
                    "children": [
                      {
                        "type": "slot",
                        "role": "off_hand",
                        "ghost": "../../textures/gui/slot/off_hand.png"
                      }
                    ]
                  },
                  {
                    "type": "frame",
                    "style": "panel.inset",
                    "layout": { "pad": [1, 1, 1, 1] },
                    "compact_layout": { "w": 0, "h": 0, "pad": [0, 0, 0, 0] },
                    "children": [
                      {
                        "type": "image",
                        "id": "player_view",
                        "image": "",
                        "layout": { "w": 48, "h": 82 },
                        "compact_layout": { "w": 0, "h": 0 },
                        "bind": { "image": "player_view" }
                      }
                    ]
                  },
                  {
                    "type": "frame",
                    "layout": { "dir": "column", "gap": 4 },
                    "compact_layout": { "dir": "row" },
                    "children": [
                      {
                        "type": "slot",
                        "role": "worn_head",
                        "ghost": "../../textures/gui/slot/head.png"
                      },
                      {
                        "type": "slot",
                        "role": "worn_chest",
                        "ghost": "../../textures/gui/slot/chest.png"
                      },
                      {
                        "type": "slot",
                        "role": "worn_legs",
                        "ghost": "../../textures/gui/slot/legs.png"
                      },
                      {
                        "type": "slot",
                        "role": "worn_feet",
                        "ghost": "../../textures/gui/slot/feet.png"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "column",
                "children": [
                  {
                    "type": "slot_grid",
                    "role": "player_inv",
                    "cols": 9,
                    "rows": 3
                  },
                  {
                    "type": "slot_grid",
                    "role": "hotbar",
                    "cols": 9,
                    "rows": 1,
                    "layout": { "margin": [0, 2, 0, 0] }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "tooltip",
        "style": "panel.inset",
        "layout": {
          "max_w": 200,
          "abs": { "x": 4, "y": 4 },
          "pad": [3, 2, 3, 3],
          "gap": 2,
          "align": "stretch"
        },
        "bind": { "visible": "show_recipe_tip" },
        "children": [
          {
            "type": "row",
            "layout": { "gap": 3, "align": "center" },
            "children": [
              {
                "type": "hook",
                "id": "craft_tip_result",
                "layout": { "w": 16, "h": 16 }
              },
              {
                "type": "label",
                "small": true,
                "wrap": true,
                "layout": { "max_w": 160 },
                "bind": { "text": "craft_tip_name" }
              }
            ]
          },
          {
            "type": "hook",
            "id": "craft_tip_ingredients",
            "layout": { "w": { "grow": 1 }, "min_w": 84, "h": 12 },
            "bind": { "min_w": "craft_tip_ingredients_w" }
          }
        ]
      }
    ]
  }
}
